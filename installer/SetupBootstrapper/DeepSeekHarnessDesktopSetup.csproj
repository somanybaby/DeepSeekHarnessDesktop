<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DeepSeekHarnessDesktopSetup</AssemblyName>
    <Version>1.0.3</Version>
    <FileVersion>1.0.3.0</FileVersion>
    <RootNamespace>DeepSeekHarnessDesktopSetup</RootNamespace>
    <PayloadPath Condition="'$(PayloadPath)' == ''"></PayloadPath>
  </PropertyGroup>

  <!-- Build-OfflineSetup.ps1 provides this archive at publish time. -->
  <ItemGroup Condition="'$(PayloadPath)' != '' and Exists('$(PayloadPath)')">
    <EmbeddedResource Include="$(PayloadPath)" LogicalName="DeepSeekHarnessDesktop.OfflinePayload" />
  </ItemGroup>
</Project>
