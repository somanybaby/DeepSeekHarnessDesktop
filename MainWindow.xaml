<Window x:Class="DeepSeekHarnessDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="DeepSeek Harness"
        Width="1280"
        Height="820"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F7F8FA">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="38" />
    </Grid.RowDefinitions>

    <wv2:WebView2 x:Name="Browser"
                  Grid.Row="0"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch" />

    <Border x:Name="StatusOverlay"
            Grid.Row="0"
            Background="#F7F8FA"
            Visibility="Visible">
      <StackPanel Width="520"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
        <TextBlock x:Name="StatusTitle"
                   Text="正在启动 DeepSeek Harness…"
                   FontFamily="Segoe UI"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="#111827"
                   TextAlignment="Center" />
        <TextBlock x:Name="StatusDetails"
                   Margin="0,14,0,0"
                   Text="正在准备桌面环境，请稍候。"
                   FontFamily="Segoe UI"
                   FontSize="14"
                   Foreground="#6B7280"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
        <Button x:Name="RetryButton"
                Width="120"
                Height="36"
                Margin="0,22,0,0"
                Content="重新加载"
                Click="RetryButton_OnClick"
                Visibility="Collapsed" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1"
            Background="#FFFFFF"
            BorderBrush="#E5E7EB"
            BorderThickness="0,1,0,0"
            Padding="14,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="VersionText"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI"
                   FontSize="12"
                   Foreground="#6B7280"
                   Text="桌面端 · Harness 正在启动" />
        <Button x:Name="ApiConfigButton"
                Grid.Column="1"
                MinWidth="78"
                Height="28"
                Margin="12,0,0,0"
                Padding="10,0"
                VerticalAlignment="Center"
                Content="API 配置"
                Click="ApiConfigButton_OnClick" />
        <Button x:Name="PluginsButton"
                Grid.Column="2"
                MinWidth="78"
                Height="28"
                Margin="8,0,0,0"
                Padding="10,0"
                VerticalAlignment="Center"
                Content="插件设置"
                Click="PluginsButton_OnClick" />
        <Button x:Name="PluginCenterButton"
                Grid.Column="3"
                MinWidth="78"
                Height="28"
                Margin="8,0,0,0"
                Padding="10,0"
                VerticalAlignment="Center"
                Content="插件中心"
                Click="PluginCenterButton_OnClick" />
        <TextBlock x:Name="UpdateStatusText"
                   Grid.Column="4"
                   Margin="16,0,0,0"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI"
                   FontSize="12"
                   Foreground="#6B7280"
                   Text="" />
        <Button x:Name="UpdateButton"
                Grid.Column="5"
                MinWidth="88"
                Height="28"
                Margin="10,0,0,0"
                Padding="12,0"
                VerticalAlignment="Center"
                Content="立即更新"
                Click="UpdateButton_OnClick"
                Visibility="Collapsed" />
      </Grid>
    </Border>
  </Grid>
</Window>
